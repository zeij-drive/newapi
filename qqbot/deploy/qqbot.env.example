QQ_BOT_APP_ID=your-qq-bot-app-id
QQ_BOT_APP_SECRET=your-qq-bot-app-secret
NEW_API_URL=https://newapi.example.com
STARRY_API_BOT_SECRET=replace-with-the-same-random-secret-configured-in-newapi
QQ_BOT_LISTEN_ADDR=127.0.0.1:9000
QQ_BOT_WEBHOOK_PATH=/qqbot
# Optional: configure both paths to let the bot serve HTTPS directly.
# QQ_BOT_TLS_CERT_FILE=/etc/ssl/starryapi/fullchain.pem
# QQ_BOT_TLS_KEY_FILE=/etc/ssl/starryapi/privkey.pem
